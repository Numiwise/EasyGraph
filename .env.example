# ============================================================
# LightRAG + Neo4j 部署配置（示例文件 / 模板）
# ------------------------------------------------------------
# 用法：复制为 .env 后填入你自己的实际值
#     cp .env.example .env
# 然后 docker compose up -d 即可启动整套系统。
#
# 默认值策略（行业实践 / 12-Factor App）：
#   - 数据库/容器内部凭证（Neo4j/Postgres/pgAdmin/Bridge Token）
#       提供本地/CI 默认值（不会影响代码与 release 仓库公开度）。
#   - 外部服务的 key / host / model
#       一律留空占位（无具体厂商），由用户根据自己使用的服务自行填入。
#       不同用户可能用 OpenAI / Anthropic / DeepSeek / SiliconFlow / 月之暗面 /
#       智谱 GLM / 自建 OpenAI 兼容网关 等任何兼容服务。
#
# 安全建议（**部署到非本地环境前**请务必替换以下默认值）：
#   - NEO4J_PASSWORD / POSTGRES_PASSWORD / PGADMIN_PASSWORD
#       本仓库公开，默认密码已知。对外/外网环境必须改成强随机密码。
#   - BRIDGE_TOKEN
#       默认是 dev-bridge-token（开发用，公开仓库已知），
#       生产/对外环境必须改成强随机串（openssl rand -hex 32）。
#
# 安全提示：
#   - .env 已加入 .gitignore，**不要提交到 git**。
#   - 本文件里出现的"开发默认值"（DB 密码 / Bridge Token）**仅供本地/CI 使用**。
# ============================================================

# ============ Server ============
# HOST=127.0.0.1 表示仅本机可访问 Web UI（更安全）；改 0.0.0.0 则局域网可访问
HOST=127.0.0.1
PORT=9621

# ============ LLM（OpenAI 兼容服务；key/host/model 用户自填）============
# 兼容性：任何兼容 OpenAI /v1/chat/completions 协议的服务即可
# （OpenAI、Anthropic via gateway、DeepSeek、SiliconFlow、月之暗面、智谱 GLM、自建网关…）
LLM_BINDING=openai
# 你的 LLM 服务 base URL（不含 /chat/completions，SDK 会自动拼接）
LLM_BINDING_HOST=https://REPLACE_WITH_YOUR_LLM_HOST/v1
# 你的 LLM API key（不要写示例 key；任何具体厂商的占位符都不写）
LLM_BINDING_API_KEY=REPLACE_WITH_YOUR_LLM_API_KEY
# 你的 LLM 模型名（按服务后台实际提供的名称填）
LLM_MODEL=REPLACE_WITH_YOUR_LLM_MODEL

# ============ Embedding（与 LLM 同协议，多数情况可共用一个 base）============
# base URL 通常与 LLM 同源，但可以分开（如自建 embedding 服务）
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://REPLACE_WITH_YOUR_EMBEDDING_HOST/v1
# 你的 Embedding API key（多数平台与 LLM 共用同一 key；按你实际情况填）
EMBEDDING_BINDING_API_KEY=REPLACE_WITH_YOUR_EMBEDDING_API_KEY
# 你的 Embedding 模型名（如 bge-m3 / text-embedding-3-small / bge-large-zh…）
EMBEDDING_MODEL=REPLACE_WITH_YOUR_EMBEDDING_MODEL
# Embedding 输出维度（必须与服务方实际返回一致，否则向量检索会出错）
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_USE_BASE64=false

# ============ Storage 后端 ============
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
LIGHTRAG_VECTOR_STORAGE=QdrantVectorDBStorage
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage

# ============ Neo4j（默认值；生产建议替换为强随机密码）============
# 默认值 lightrag-localdev-neo4j：本地/CI 开箱即用，不至于"无密码启动"。
# ⚠️ 部署到任何对外环境前，**强烈建议**改为强随机密码（openssl rand -hex 16）。
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=lightrag-localdev-neo4j
NEO4J_DATABASE=neo4j

# ============ PostgreSQL（默认值；生产建议替换）============
# 默认值 lightrag-localdev-pg / lightrag-localdev-admin：本地/CI 开箱即用。
# ⚠️ 部署到任何对外环境前，**强烈建议**改为强随机密码。
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=lightrag
POSTGRES_PASSWORD=lightrag-localdev-pg
POSTGRES_DATABASE=lightrag
# pgAdmin Web UI 登录（http://localhost:5050）
PGADMIN_EMAIL=admin@local.test
PGADMIN_PASSWORD=lightrag-localdev-admin

# ============ Qdrant ============
QDRANT_URL=http://qdrant:6333

# ============ 后端 api-bridge 内部 Token ============
# 默认 dev-bridge-token：让首次开箱即用（容器内 nginx 与 api-bridge 默认共享）。
# ⚠️ 部署到任何对外环境前，**强烈建议**改为强随机串：
#      openssl rand -hex 32
#    同步修改 docker-compose.yml 把 webviz 与 api-bridge 的 BRIDGE_TOKEN 注入指向新值。
BRIDGE_TOKEN=dev-bridge-token

# ============ Misc ============
SUMMARY_LANGUAGE=Chinese

# ============ Prompt 自定义（领域定制） ============
ENTITY_EXTRACTION_USE_JSON=true
ENTITY_TYPE_PROMPT_FILE=lychee_culture.yml
MAX_EXTRACTION_RECORDS=60
MAX_EXTRACTION_ENTITIES=30
MAX_GLEANING=2

# ============ Rerank（可选：提升检索质量）============
# 与 LLM/Embedding 相同的"占位 + 用户填"模式。
# 仅启用 Rerank 时取消注释并填实际值；留空则后端跳过重排序。
# RERANK_BINDING=cohere
# RERANK_MODEL=REPLACE_WITH_YOUR_RERANK_MODEL
# RERANK_BINDING_HOST=https://REPLACE_WITH_YOUR_RERANK_HOST/v1/rerank
# RERANK_BINDING_API_KEY=REPLACE_WITH_YOUR_RERANK_API_KEY