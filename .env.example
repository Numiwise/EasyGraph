# ============================================================
# LightRAG + Neo4j 部署配置（示例文件）
# ------------------------------------------------------------
# 复制为 .env 并填入你自己的 key：
#   cp .env.example .env
# 然后 docker compose up -d 即可启动。
#
# 安全提示：
#   - .env 已加入 .gitignore，**不要提交到 git**。
#   - 本文件**不提供任何默认密码**。任何真实凭证都必须由用户自己填入；
#     缺失相应字段时，docker compose 会拒绝启动（fail-fast），不会使用
#     任何"通用口令"——这是为了避免公共仓库的演示部署变成全网通用入口。
#   - 建议给每个部署生成独立的随机密码，例如：
#       openssl rand -hex 24      # 生成 48 字符的随机串
# ============================================================

# ============ Server ============
# HOST=127.0.0.1 表示仅本机可访问 Web UI（更安全）；改 0.0.0.0 则局域网可访问
HOST=127.0.0.1
PORT=9621

# ============ LLM (任意 OpenAI 兼容服务即可) ============
# 例：SiliconFlow DeepSeek-V3、OpenAI、DeepSeek、月之暗面、智谱 GLM 等
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.siliconflow.cn/v1
# 替换为你自己的 key（LLM 与 Embedding 通常可共用一个 key）
LLM_BINDING_API_KEY=sk-REPLACE_WITH_YOUR_KEY
LLM_MODEL=deepseek-ai/DeepSeek-V3

# ============ Embedding ============
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.siliconflow.cn/v1
EMBEDDING_BINDING_API_KEY=sk-REPLACE_WITH_YOUR_KEY
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_USE_BASE64=false

# ============ Storage 后端 ============
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
LIGHTRAG_VECTOR_STORAGE=QdrantVectorDBStorage
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage

# ============ Neo4j（必填，缺失则 docker compose 拒绝启动）============
# Neo4j 服务的初始 root 密码（同时用于 neo4j + neo4j-display 两个实例的 NEO4J_AUTH）。
# 该密码会被 lightrag / api-bridge 通过 NEO4J_PASSWORD 引用，请保持三处一致。
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=REPLACE_WITH_YOUR_PASSWORD
NEO4J_DATABASE=neo4j

# ============ PostgreSQL（必填，缺失则 docker compose 拒绝启动）============
# KV / DocStatus 存储用的 Postgres 凭证。
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=lightrag
POSTGRES_PASSWORD=REPLACE_WITH_YOUR_PASSWORD
POSTGRES_DATABASE=lightrag
# pgAdmin Web UI 登录（http://localhost:5050）。与 POSTGRES_USER 可以不一样。
PGADMIN_EMAIL=admin@your-domain.com
PGADMIN_PASSWORD=REPLACE_WITH_YOUR_PASSWORD

# ============ Qdrant ============
QDRANT_URL=http://qdrant:6333

# ============ 后端 api-bridge 内部 Token（必填，缺失则 docker compose 拒绝启动）============
# 用途：nginx 在 /api/ 反代时把它写入 X-Bridge-Token 头，api-bridge 用 hmac
#       常量时间比较校验。浏览器 JS 永远拿不到这个 token（不可伪造）。
# 生成建议：openssl rand -hex 32（64 字符随机串）
BRIDGE_TOKEN=REPLACE_WITH_RANDOM_HEX

# ============ Misc ============
SUMMARY_LANGUAGE=Chinese

# ============ Prompt 自定义（领域定制） ============
ENTITY_EXTRACTION_USE_JSON=true
ENTITY_TYPE_PROMPT_FILE=lychee_culture.yml
MAX_EXTRACTION_RECORDS=60
MAX_EXTRACTION_ENTITIES=30
MAX_GLEANING=2

# ============ Rerank（可选：提升检索质量） ============
# RERANK_BINDING=cohere
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_BINDING_HOST=https://api.siliconflow.cn/v1/rerank
# RERANK_BINDING_API_KEY=sk-REPLACE_WITH_YOUR_KEY