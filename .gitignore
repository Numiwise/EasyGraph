# ============================================================
# .gitignore — 项目级 Git 忽略规则
# ============================================================

# ---- 私有材料（不入公开仓库） ----
_private/

# ---- 真实环境变量（保护密钥） ----
.env
.env.local
.env.*.local

# ---- 日志与临时 ----
logs/
*.log
*.log.*
npm-debug.log*

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
*.egg-info/

# ---- Node / Vue ----
node_modules/
dist/
.vite/

# ---- 备份与重构临时文件（不入 git） ----
_refactor_bak/
*_backup*
*.bak
backup/                            # 部署期间打包的容器卷备份目录
data-pack-tmp/                     # 跨机器传输卷数据时的临时目录

# ---- IDE 与系统 ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- 运行产物（已 parse / LightRAG 运行时数据） ----
# 解析后的 markdown 与图谱抽取结果如不希望跟随仓库版本演进，可取消注释：
# data/inputs/*/__parsed__/         # 已解析 markdown
# data/rag_storage/                 # LightRAG 工作目录
# data/lightrag-volumes/            # Docker 卷挂载根

# ---- 临时文件 / 副本 / 重命名残留（不污染 git 历史） ----
# 早期 chunking 脚本切出来的副本（_001/_001_001/_002 等）
data/inputs/*/__parsed__/*_001.md
data/inputs/*/__parsed__/*_001_001.md
data/inputs/*/__parsed__/*_001_001_001.md
data/inputs/*/__parsed__/*_001_001_001_001.md
data/inputs/*/__parsed__/*_001_001_002.md
data/inputs/*/__parsed__/*_001_002.md
data/inputs/*/__parsed__/*_001_002_001.md
data/inputs/*/__parsed__/*_002.md
data/inputs/*/__parsed__/*_003.md
data/inputs/*/__parsed__/*_004.md
data/inputs/*/__parsed__/*_005.md
data/inputs/*/__parsed__/*_006.md
data/inputs/*/__parsed__/*_007.md
data/inputs/*/__parsed__/*_008.md
data/inputs/*/__parsed__/*_009.md
data/inputs/*/__parsed__/*_010.md
data/inputs/demo_show/             # 早期 demo 分支残留数据
_tmp_*                            # 上传时临时重命名残留
*_tmp_*.md                          # 含 _tmp_ 前缀的 md 文件