# ============================================================
# 腾讯云部署用 .env 模板（不含 LLM key）
# ------------------------------------------------------------
# 部署步骤：
#   1) cp .env.cloud.template .env
#   2) openssl rand -hex 32  # 生成新的 BRIDGE_TOKEN
#   3) 把生成的 token 填到 .env 第 5 行
#   4) 手动填 NEO4J_PASSWORD / POSTGRES_PASSWORD（用新密码，跟本地的不一样）
#   5) 手动填 LLM_BINDING_API_KEY（用你自己的 MiniMax / 火山 / 硅基 真实 key）
#   6) chmod 600 .env  # 防止其他用户读
#
# 这个 .env 不进 git（已经在 .gitignore 里）
# ============================================================

# ============ Server ============
HOST=0.0.0.0
PORT=9621

# ============ LLM (默认 MiniMax-M3，OpenAI 兼容) ============
# 优先级：MiniMax → 火山引擎 → SiliconFlow DeepSeek
# 切换：手动换 HOST/KEY/MODEL 三行 + 重启 lightrag-server
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.minimax.chat/v1
LLM_BINDING_API_KEY=__FILL_IN_YOUR_MINIMAX_KEY__
LLM_MODEL=MiniMax-M3

# ============ Storage 后端 ============
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
LIGHTRAG_VECTOR_STORAGE=QdrantVectorDBStorage
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage

# ============ Neo4j 连接 ============
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=__FILL_IN_NEW_NEO4J_PASSWORD__
NEO4J_DATABASE=neo4j

# ============ PostgreSQL 连接 ============
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=lightrag
POSTGRES_PASSWORD=__FILL_IN_NEW_POSTGRES_PASSWORD__
POSTGRES_DATABASE=lightrag

# ============ Qdrant ============
QDRANT_URL=http://qdrant:6333

# ============ Backend api-bridge 内部 Token ============
# 生成方式：openssl rand -hex 32
BRIDGE_TOKEN=__GENERATE_WITH_OPENSSL_RAND_HEX_32__

# ============ Misc ============
SUMMARY_LANGUAGE=Chinese
ENTITY_EXTRACTION_USE_JSON=true
ENTITY_TYPE_PROMPT_FILE=lychee_culture.yml
MAX_EXTRACTION_RECORDS=60
MAX_EXTRACTION_ENTITIES=30
MAX_GLEANING=2

# ============ Rerank ============
RERANK_BINDING=cohere
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BINDING_HOST=https://api.siliconflow.cn/v1/rerank
RERANK_BINDING_API_KEY=__FILL_IN_YOUR_SILICONFLOW_KEY__

# ============ Embedding ============
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.siliconflow.cn/v1
EMBEDDING_BINDING_API_KEY=__FILL_IN_YOUR_SILICONFLOW_KEY__
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_USE_BASE64=false

# ============ 公网域名（无域名用 IP） ============
SERVER_NAME=1.14.192.68
